{
  "name": "ccasso-scanner",
  "version": "2.3.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "expo start",
    "start:dev": "expo start --dev-client --lan",
    "start:go": "expo start --go --lan",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo run:android",
    "android:device": "powershell -ExecutionPolicy Bypass -File scripts/android-local.ps1",
    "android:apk": "powershell -ExecutionPolicy Bypass -File scripts/android-local.ps1 -BuildOnly",
    "android:apk:local": "powershell -ExecutionPolicy Bypass -File scripts/android-local.ps1 -BuildOnly -Release -LocalTest",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "npx eas-cli build --platform android --profile preview"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.0",
    "expo-av": "~16.0.0",
    "expo-camera": "~17.0.0",
    "expo-constants": "~18.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.0",
    "expo-font": "~14.0.0",
    "expo-keep-awake": "~15.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sharing": "~14.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-preset-expo": "~54.0.0"
  },
  "private": true
}
